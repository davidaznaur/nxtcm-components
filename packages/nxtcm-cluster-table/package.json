{
  "name": "@redhat-cloud-services/nxtcm-cluster-table",
  "version": "6.0.0",
  "description": "Generic PatternFly cluster table with a reusable client-side grid engine",
  "author": "Red Hat",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/RedHatInsights/nxtcm-components.git",
    "directory": "packages/nxtcm-cluster-table"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "components",
    "patternfly",
    "acm",
    "ocm",
    "red-hat",
    "insights",
    "typescript",
    "ui"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE",
    "build": "npm run type-check && rm -rf dist && vite build --config ../../vite.config.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "prettier:check": "prettier --check 'src/**/*.{js,ts,mjs,jsx,tsx}'",
    "prettier:fix": "prettier --write 'src/**/*.{js,ts,mjs,jsx,tsx}'",
    "test": "jest --config ../../jest.config.js packages/nxtcm-cluster-table --passWithNoTests",
    "test:ct": "playwright test -c ../../playwright.config.ts --project=components packages/nxtcm-cluster-table",
    "allthethings": "npm run prettier:fix && npm run lint:fix && npm run type-check && npm run test && npm run test:ct"
  },
  "peerDependencies": {
    "@patternfly/react-core": "^6.0.0",
    "@patternfly/react-icons": "^6.3.1",
    "@patternfly/react-table": "^6.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "@patternfly/react-drag-drop": "^6.7.0"
  },
  "devDependencies": {
    "@patternfly/react-icons": "^6.3.1",
    "@patternfly/react-table": "^6.0.0",
    "@patternfly/react-drag-drop": "^6.7.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
